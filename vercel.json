{
 "redirects": [
  {
   "source": "/site/:path*",
   "destination": "/:path*",
   "permanent": true
  },
  {
   "source": "/site",
   "destination": "/",
   "permanent": true
  }
 ],
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=0, must-revalidate"
    }
   ]
  },
  {
   "source": "/assets/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/admin/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-store, must-revalidate"
    },
    {
     "key": "Pragma",
     "value": "no-cache"
    }
   ]
  },
  {
   "source": "/admin",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-store, must-revalidate"
    },
    {
     "key": "Pragma",
     "value": "no-cache"
    }
   ]
  }
 ]
}